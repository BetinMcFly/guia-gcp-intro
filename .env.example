# Variables de entorno de guia-gcp-intro.
#
# El sitio es estático y público: no necesita secretos para construirse ni para
# funcionar. Este archivo existe para documentar lo poco que hay y para que nadie
# meta credenciales en el repositorio.
#
# Copia a .env.local para desarrollo. Las variables NEXT_PUBLIC_* se incrustan en
# el HTML en build: nunca pongas ahí nada privado.

# URL pública canónica. Se usa en metadatos y enlaces absolutos.
NEXT_PUBLIC_SITE_URL=https://guia-gcp.albertosolano.dev

# Proyecto de Firebase/GCP. Firebase CLI lo lee de .firebaserc; aquí solo como referencia.
FIREBASE_PROJECT=claude-projects-496723

# Solo para desplegar a mano desde una máquina sin `firebase login`.
# Ruta a la clave JSON de la service account github-actions-deploy@.
# En CI NO se usa: la clave vive en el secreto FIREBASE_SERVICE_ACCOUNT del repositorio.
# GOOGLE_APPLICATION_CREDENTIALS=/ruta/privada/sa.json
